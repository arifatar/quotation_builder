# Copy to .env.local for local development with `vercel dev`.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# CSV export URL of the "Items" tab of your Google Sheet.
# Format: https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<ITEMS_TAB_GID>
ITEMS_SHEET_CSV_URL=

# CSV export URL of the "Settings" tab of the same (or another) Google Sheet.
# Format: https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<SETTINGS_TAB_GID>
SETTINGS_SHEET_CSV_URL=

# The sheet must be shared as "Anyone with the link – Viewer" for these
# export URLs to work without needing a Google API key.
