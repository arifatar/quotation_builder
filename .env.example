# Copy to .env.local for local development with `vercel dev`.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Your Neon Postgres connection string (from the Neon dashboard, or auto-filled
# if you add Neon via Vercel's Storage/Marketplace integration).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The password you'll type into the app's "Admin" unlock box to edit
# categories, items, prices, and company settings. Make this a real password.
ADMIN_PASSWORD=change-me
